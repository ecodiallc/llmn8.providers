    },
    "requestCount": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "costUsd": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "currency": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "latencyMs": {
