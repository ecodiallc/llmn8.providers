{
  "id": "novita",
  "displayName": "Novita AI",
  "rev": 1,
  "docsUrl": "https://novita.ai/docs/api-reference/basic-billing",
  "capabilities": {
    "models": true,
    "chat": true,
    "usage": true,
    "balance": true,
    "keyUsage": false
  },
  "usage": {
    "syncMode": "native",
    "managementKeyRequired": false,
    "granularity": "daily",
    "bucketTimezone": "utc",
    "reportingLagHours": null,
    "revisionWindowDays": 1,
    "backfillMaxDays": 31,
    "syncThrottleMinutes": 5,
    "pagination": {
      "kind": "none",
      "maxPages": 1
    }
  },
  "metrics": {
    "inputTokens": {
      "availability": "reported"
    },
    "outputTokens": {
      "availability": "reported"
    },
    "cachedTokens": {
      "availability": "reported"
    },
    "reasoningTokens": {
      "availability": "reported"
    },
    "requestCount": {
      "availability": "reported"
    },
    "costUsd": {
      "availability": "reported"
    },
    "currency": {
      "availability": "reported"
    },
    "latencyMs": {
      "availability": "client_only"
    },
    "status": {
      "availability": "client_only"
    }
  },
  "actions": {
    "models": "enabled",
    "compare": "enabled",
    "balance": "visible"
  },
  "adapter": {
    "mode": "native",
    "usageSource": "novita-activity"
  },
  "setup": {
    "summaryKey": "providers.setupNovita"
  },
  "notes": "Bill API supports Hour/Day/Week/Month cycles; the app requests Day. The adapter splits long ranges into 31-day requests and the endpoint has no page cursor. Reasonable first candidate for a descriptor adapter."
}
