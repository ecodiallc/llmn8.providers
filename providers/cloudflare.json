{
  "id": "cloudflare",
  "displayName": "Cloudflare Workers AI",
  "rev": 1,
  "docsUrl": "https://developers.cloudflare.com/workers-ai/",
  "capabilities": {
    "models": false,
    "chat": false,
    "usage": true,
    "balance": false,
    "keyUsage": false
  },
  "usage": {
    "syncMode": "native",
    "managementKeyRequired": false,
    "granularity": "hourly",
    "bucketTimezone": "utc",
    "reportingLagHours": null,
    "revisionWindowDays": 1,
    "backfillMaxDays": 30,
    "syncThrottleMinutes": 5,
    "pagination": {
      "kind": "none",
      "maxPages": 1
    }
  },
  "metrics": {
    "inputTokens": {
      "availability": "not_supported",
      "reason": "neurons_only"
    },
    "outputTokens": {
      "availability": "not_supported",
      "reason": "neurons_only"
    },
    "cachedTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "reasoningTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "requestCount": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "costUsd": {
      "availability": "estimated",
      "reason": "neurons_times_rate"
    },
    "currency": {
      "availability": "estimated",
      "reason": "assumed_usd"
    },
    "latencyMs": {
      "availability": "client_only"
    },
    "status": {
      "availability": "client_only"
    }
  },
  "extraMetrics": {
    "neurons": {
      "availability": "reported"
    }
  },
  "actions": {
    "models": "disabled",
    "compare": "disabled",
    "balance": "hidden"
  },
  "adapter": {
    "mode": "native",
    "usageSource": "cloudflare-activity"
  },
  "setup": {
    "summaryKey": "providers.setupCloudflare"
  },
  "notes": "GraphQL analytics report neurons, not tokens, in hourly buckets, and are explicitly not real-time. Cost is derived as neurons x the configured USD rate (default 0.011 per 1k neurons), marked estimated."
}
