{
  "id": "together",
  "displayName": "Together AI",
  "rev": 1,
  "docsUrl": "https://docs.together.ai/docs/billing",
  "capabilities": {
    "models": true,
    "chat": true,
    "usage": false,
    "balance": false,
    "keyUsage": false
  },
  "usage": {
    "syncMode": "none",
    "managementKeyRequired": false,
    "granularity": "none",
    "bucketTimezone": "utc",
    "reportingLagHours": null,
    "revisionWindowDays": 0,
    "backfillMaxDays": 0,
    "syncThrottleMinutes": 5,
    "pagination": {
      "kind": "none",
      "maxPages": 1
    }
  },
  "metrics": {
    "inputTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "outputTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "cachedTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "reasoningTokens": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "requestCount": {
      "availability": "not_supported",
      "reason": "no_api"
    },
    "costUsd": {
      "availability": "estimated",
      "reason": "model_pricing"
    },
    "currency": {
      "availability": "estimated",
      "reason": "assumed_usd"
    },
    "latencyMs": {
      "availability": "client_only"
    },
    "status": {
      "availability": "client_only"
    }
  },
  "actions": {
    "models": "enabled",
    "compare": "enabled",
    "balance": "hidden"
  },
  "adapter": {
    "mode": "native",
    "usageSource": null
  },
  "setup": {
    "summaryKey": "providers.setupTogether"
  },
  "notes": "No account usage API. The billing beta has no model breakdown, so app-recorded calls are the only model-level history; cost is estimated from cached model pricing when available."
}
