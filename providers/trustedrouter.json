{
  "id": "trustedrouter",
  "displayName": "TrustedRouter",
  "rev": 1,
  "docsUrl": "https://trustedrouter.com",
  "capabilities": {
    "models": true,
    "chat": true,
    "usage": true,
    "balance": true,
    "keyUsage": false
  },
  "usage": {
    "syncMode": "native",
    "managementKeyRequired": true,
    "granularity": "daily",
    "bucketTimezone": "utc",
    "reportingLagHours": null,
    "revisionWindowDays": 1,
    "backfillMaxDays": 30,
    "syncThrottleMinutes": 5,
    "pagination": {
      "kind": "none",
      "maxPages": 1
    }
  },
  "metrics": {
    "inputTokens": {
      "availability": "reported"
    },
    "outputTokens": {
      "availability": "reported"
    },
    "cachedTokens": {
      "availability": "reported"
    },
    "reasoningTokens": {
      "availability": "reported"
    },
    "requestCount": {
      "availability": "reported"
    },
    "costUsd": {
      "availability": "reported"
    },
    "currency": {
      "availability": "reported"
    },
    "latencyMs": {
      "availability": "client_only"
    },
    "status": {
      "availability": "client_only"
    }
  },
  "actions": {
    "models": "enabled",
    "compare": "enabled",
    "balance": "visible"
  },
  "adapter": {
    "mode": "native",
    "usageSource": "trustedrouter-activity"
  },
  "setup": {
    "summaryKey": "providers.setupTrustedRouter"
  },
  "notes": "Management key for activity, normal key for balance. The control plane has no date-range filter, so rows are filtered client-side. Account-level activity only (no per-key attribution)."
}
